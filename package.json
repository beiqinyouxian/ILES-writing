{
  "name": "ielts-writing-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "离线雅思写作练习桌面应用（Lesson 1 完整 + 练习与提示联动）",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -r \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER=1 electron .\"",
    "electron:dev": "cross-env VITE_DEV_SERVER=1 electron .",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "postinstall": "node -e \"try{require('electron')}catch(e){console.log('electron not installed yet')}\""
  },
  "build": {
    "appId": "com.ielts.writing.desktop",
    "productName": "雅思写作练习",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.2",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.2"
  }
}

